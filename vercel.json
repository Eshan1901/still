{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "buildCommand": "pnpm --filter @still/api build",
      "outputDirectory": "apps/api/dist",
      "framework": "nestjs"
    },
    "web": {
      "buildCommand": "pnpm --filter @still/web build",
      "outputDirectory": "apps/web/dist",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
