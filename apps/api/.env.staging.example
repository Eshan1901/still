NODE_ENV=staging
PORT=3001
DATABASE_URL=mysql://USER:PASSWORD@DB_HOST:3306/still_staging
JWT_SECRET=replace-with-staging-random-secret-at-least-32-characters
WEB_ORIGINS=https://staging.example.com
SESSION_HOURS=168
# Set to the actual trusted proxy hop count. Keep 0 for a direct listener.
TRUST_PROXY_HOPS=0
COOKIE_SAME_SITE=lax
