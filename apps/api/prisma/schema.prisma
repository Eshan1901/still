generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum ProjectStatus {
  NOT_STARTED @map("Not Started")
  IN_PROGRESS @map("In Progress")
  ON_HOLD     @map("On Hold")
  COMPLETED   @map("Completed")
  CANCELLED   @map("Cancelled")
}

enum TaskStatus {
  PENDING     @map("Pending")
  IN_PROGRESS @map("In Progress")
  IN_REVIEW   @map("In Review")
  COMPLETED   @map("Completed")
  CANCELLED   @map("Cancelled")
}

enum Priority {
  LOW      @map("Low")
  MEDIUM   @map("Medium")
  HIGH     @map("High")
  CRITICAL @map("Critical")
}

enum MemberRole {
  OWNER  @map("Owner")
  ADMIN  @map("Admin")
  MEMBER @map("Member")
  VIEWER @map("Viewer")
}

// ─── Core Identity ────────────────────────────────────────────────────────────

/// Registered user account.
model User {
  id           String  @id @default(uuid()) @db.VarChar(36)
  fullName     String  @db.VarChar(100)
  email        String  @unique @db.VarChar(254)
  passwordHash String  @db.Text
  avatarUrl    String? @db.VarChar(512)
  bio          String? @db.VarChar(300)
  timezone     String  @default("UTC") @db.VarChar(64)
  isActive     Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  sessions        AuthSession[]
  ownedProjects   Project[]         @relation("ProjectOwner")
  memberships     ProjectMember[]
  assignedTasks   Task[]            @relation("TaskAssignee")
  comments        TaskComment[]
  activityLogs    ActivityLog[]
  notifications   Notification[]

  @@index([email, isActive])
}

/// Session record for JWT + CSRF management.
model AuthSession {
  id        String    @id @default(uuid()) @db.VarChar(36)
  userId    String    @db.VarChar(36)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  csrfHash  String    @db.Text
  userAgent String?   @db.VarChar(512)
  ipAddress String?   @db.VarChar(45)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
  @@index([userId, revokedAt])
}

// ─── Projects ────────────────────────────────────────────────────────────────

/// A project owned by a user, optionally shared with team members.
model Project {
  id          String        @id @default(uuid()) @db.VarChar(36)
  ownerId     String        @db.VarChar(36)
  owner       User          @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  name        String        @db.VarChar(120)
  description String        @db.Text
  status      ProjectStatus @default(NOT_STARTED)
  priority    Priority      @default(MEDIUM)
  coverColor  String        @default("#6366f1") @db.VarChar(7)
  startDate   DateTime      @db.Date
  endDate     DateTime      @db.Date
  isArchived  Boolean       @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks       Task[]
  members     ProjectMember[]
  labels      Label[]
  milestones  Milestone[]
  activityLogs ActivityLog[]

  @@index([ownerId, status, createdAt])
  @@index([ownerId, isArchived, createdAt])
}

/// Project team member with a role.
model ProjectMember {
  id        String     @id @default(uuid()) @db.VarChar(36)
  projectId String     @db.VarChar(36)
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String     @db.VarChar(36)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      MemberRole @default(MEMBER)
  joinedAt  DateTime   @default(now())

  @@unique([projectId, userId])
  @@index([userId])
}

/// A trackable milestone within a project.
model Milestone {
  id          String    @id @default(uuid()) @db.VarChar(36)
  projectId   String    @db.VarChar(36)
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String    @db.VarChar(120)
  description String?   @db.Text
  dueDate     DateTime  @db.Date
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tasks Task[]

  @@index([projectId, dueDate])
}

// ─── Tasks ───────────────────────────────────────────────────────────────────

/// A unit of work within a project.
model Task {
  id           String     @id @default(uuid()) @db.VarChar(36)
  projectId    String     @db.VarChar(36)
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestoneId  String?    @db.VarChar(36)
  milestone    Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  assigneeId   String?    @db.VarChar(36)
  assignee     User?      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  parentTaskId String?    @db.VarChar(36)
  parentTask   Task?      @relation("SubTasks", fields: [parentTaskId], references: [id], onDelete: SetNull)
  subTasks     Task[]     @relation("SubTasks")

  name        String     @db.VarChar(120)
  description String     @db.Text
  priority    Priority   @default(MEDIUM)
  status      TaskStatus @default(PENDING)
  dueDate     DateTime   @db.Date
  estimatedHours Decimal? @db.Decimal(6, 2)
  actualHours    Decimal? @db.Decimal(6, 2)
  position    Int        @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  labels      TaskLabel[]
  comments    TaskComment[]
  attachments TaskAttachment[]
  activityLogs ActivityLog[]

  @@index([projectId, status, priority, createdAt])
  @@index([assigneeId, status, dueDate])
  @@index([milestoneId])
  @@index([parentTaskId])
}

// ─── Labels ──────────────────────────────────────────────────────────────────

/// A colour-coded label scoped to a project.
model Label {
  id        String @id @default(uuid()) @db.VarChar(36)
  projectId String @db.VarChar(36)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String @db.VarChar(50)
  color     String @default("#94a3b8") @db.VarChar(7)

  createdAt DateTime @default(now())

  tasks TaskLabel[]

  @@unique([projectId, name])
}

/// Join table between Task and Label.
model TaskLabel {
  taskId  String @db.VarChar(36)
  task    Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  labelId String @db.VarChar(36)
  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@index([labelId])
}

// ─── Comments & Attachments ───────────────────────────────────────────────────

/// A comment left on a task.
model TaskComment {
  id        String  @id @default(uuid()) @db.VarChar(36)
  taskId    String  @db.VarChar(36)
  task      Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String  @db.VarChar(36)
  author    User    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String  @db.Text
  editedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId, createdAt])
  @@index([authorId])
}

/// A file or link attached to a task.
model TaskAttachment {
  id          String  @id @default(uuid()) @db.VarChar(36)
  taskId      String  @db.VarChar(36)
  task        Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fileName    String  @db.VarChar(255)
  fileUrl     String  @db.VarChar(1024)
  mimeType    String? @db.VarChar(127)
  sizeBytes   Int?
  uploadedBy  String  @db.VarChar(36)

  createdAt DateTime @default(now())

  @@index([taskId])
}

// ─── Activity & Notifications ─────────────────────────────────────────────────

/// Append-only audit log for projects and tasks.
model ActivityLog {
  id         String  @id @default(uuid()) @db.VarChar(36)
  projectId  String  @db.VarChar(36)
  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId     String? @db.VarChar(36)
  task       Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)
  actorId    String  @db.VarChar(36)
  actor      User    @relation(fields: [actorId], references: [id], onDelete: Cascade)
  action     String  @db.VarChar(80)
  detail     String? @db.Text

  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([taskId, createdAt])
  @@index([actorId])
}

/// In-app notification for a user.
model Notification {
  id         String  @id @default(uuid()) @db.VarChar(36)
  userId     String  @db.VarChar(36)
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String  @db.VarChar(120)
  body       String  @db.VarChar(500)
  link       String? @db.VarChar(512)
  isRead     Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId, isRead, createdAt])
}
